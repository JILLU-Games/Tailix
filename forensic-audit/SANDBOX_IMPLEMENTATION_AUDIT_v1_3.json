    "dropdowns.html": "\n<section class=\"vib-section border-b vib-divider sandbox-grid-bg\">\n  <div class=\"vib-container\">\n    <p class=\"vib-kicker mb-3\">Component Demo</p>\n    <h1 class=\"vib-h1 max-w-3xl\">Dropdowns.</h1>\n    <p class=\"mt-4 max-w-2xl text-[16px] leading-[1.6] vib-content\">Compact menu and popover patterns without oversized padding.</p>\n  </div>\n</section>\n<section class=\"vib-section\"><div class=\"vib-container max-w-[560px]\"><details class=\"vib-card vib-card-pad\"><summary class=\"cursor-pointer font-semibold\">Open compact dropdown</summary><div class=\"mt-4 grid gap-1 rounded-vib-card border border-vib-border bg-vib-background p-2\"><a class=\"vib-sidebar-link\" href=\"#\">Profile</a><a class=\"vib-sidebar-link\" href=\"#\">Settings</a><a class=\"vib-sidebar-link\" href=\"#\">Support</a></div></details></div></section>",
    "alerts-states.html": "\n<section class=\"vib-section border-b vib-divider sandbox-grid-bg\">\n  <div class=\"vib-container\">\n    <p class=\"vib-kicker mb-3\">Component Demo</p>\n    <h1 class=\"vib-h1 max-w-3xl\">Alerts and states.</h1>\n    <p class=\"mt-4 max-w-2xl text-[16px] leading-[1.6] vib-content\">Success, warning, danger and neutral state patterns.</p>\n  </div>\n</section>\n<section class=\"vib-section\"><div class=\"vib-container grid gap-4\"><div class=\"vib-card vib-card-pad border-vib-success\"><strong class=\"vib-status-success\">Success</strong><p class=\"mt-1 vib-content\">The operation completed successfully.</p></div><div class=\"vib-card vib-card-pad border-vib-warning\"><strong class=\"vib-status-warning\">Warning</strong><p class=\"mt-1 vib-content\">Review this item before publishing.</p></div><div class=\"vib-card vib-card-pad border-vib-danger\"><strong class=\"vib-status-danger\">Error</strong><p class=\"mt-1 vib-content\">The action could not be completed.</p></div></div></section>",
    "empty-loading-error.html": "\n<section class=\"vib-section border-b vib-divider sandbox-grid-bg\">\n  <div class=\"vib-container\">\n    <p class=\"vib-kicker mb-3\">Component Demo</p>\n    <h1 class=\"vib-h1 max-w-3xl\">Empty, loading and error states.</h1>\n    <p class=\"mt-4 max-w-2xl text-[16px] leading-[1.6] vib-content\">Low-noise feedback patterns with text labels, not color alone.</p>\n  </div>\n</section>\n<section class=\"vib-section\"><div class=\"vib-container grid gap-4 md:grid-cols-3\"><article class=\"vib-card vib-card-pad\"><h2 class=\"vib-h3\">Empty</h2><p class=\"mt-2 vib-muted\">No projects yet. Create the first item.</p></article><article class=\"vib-card vib-card-pad\"><h2 class=\"vib-h3\">Loading</h2><p class=\"mt-2 vib-muted\">Loading data\u2026</p><div class=\"mt-4 h-2 rounded-full bg-vib-hover\"><div class=\"h-2 w-1/3 rounded-full bg-vib-secondary\"></div></div></article><article class=\"vib-card vib-card-pad\"><h2 class=\"vib-h3 vib-status-danger\">Error</h2><p class=\"mt-2 vib-muted\">Show a clear recovery action.</p></article></div></section>",
    "typography-colors.html": "\n<section class=\"vib-section border-b vib-divider sandbox-grid-bg\">\n  <div class=\"vib-container\">\n    <p class=\"vib-kicker mb-3\">Token Demo</p>\n    <h1 class=\"vib-h1 max-w-3xl\">Typography and color tokens.</h1>\n    <p class=\"mt-4 max-w-2xl text-[16px] leading-[1.6] vib-content\">Visual token sheet with compact type scale and color swatches.</p>\n  </div>\n</section>\n<section class=\"vib-section\"><div class=\"vib-container grid gap-5 lg:grid-cols-2\"><div class=\"vib-card vib-card-pad\"><p class=\"vib-kicker\">Type scale</p><h1 class=\"vib-h1 mt-3\">Hero 32\u201340px</h1><h2 class=\"vib-h2 mt-4\">H2 24px</h2><h3 class=\"vib-h3 mt-3\">H3 18px</h3><p class=\"mt-3 text-[14px] vib-content\">Body text uses 14\u201316px depending on context.</p><code class=\"mt-3 block text-[13px] text-vib-secondary\">JetBrains Mono 13px</code></div><div class=\"vib-card vib-card-pad\"><p class=\"vib-kicker\">Colors</p><div class=\"mt-4 grid gap-3\"><div class=\"flex items-center gap-3\"><span class=\"h-8 w-12 rounded bg-vib-background border border-vib-border\"></span>#0D1117</div><div class=\"flex items-center gap-3\"><span class=\"h-8 w-12 rounded bg-vib-surface border border-vib-border\"></span>#161B22</div><div class=\"flex items-center gap-3\"><span class=\"h-8 w-12 rounded bg-vib-primary\"></span>#2563EB</div><div class=\"flex items-center gap-3\"><span class=\"h-8 w-12 rounded bg-vib-secondary\"></span>#38BDF8</div></div></div></div></section>"
